# ========================================
# MANUAL PAYMENT SYSTEM - Environment Variables
# ========================================
# Copy file ini menjadi .env.local untuk development
# atau set di Vercel untuk production

# ========================================
# SUPABASE (Required)
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# BANK ACCOUNT INFO (Required)
# ========================================
# Nomor rekening Mandiri Anda
BANK_ACCOUNT_NUMBER=1234567890123

# Nama rekening (sesuai dengan dokumen bank)
BANK_ACCOUNT_NAME=PT Sultan WiFi

# Nama bank
BANK_NAME=Mandiri

# ========================================
# WHATSAPP INTEGRATION (Required)
# ========================================
# Token dari Fonnte (https://fonnte.com)
FONNTE_TOKEN=your_fonnte_token_here

# Nomor WhatsApp support Anda
SUPPORT_PHONE_NUMBER=62812345678

# ========================================
# CRON JOB SECURITY (Required)
# ========================================
# Generate dengan: openssl rand -hex 32
# Ini untuk validasi cron job (prevent unauthorized access)
CRON_SECRET=your-secret-token-here

# ========================================
# APP CONFIGURATION
# ========================================
# URL aplikasi Anda (untuk link di WA)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ========================================
# PAYMENT GATEWAY (Mayar - https://mayar.id)
# ========================================
# Dapatkan API Key di Dashboard Mayar: Integration -> API Key
MAYAR_API_KEY=your_mayar_api_key_here

# Token verifikasi webhook Mayar (Opsional tapi direkomendasikan)
MAYAR_WEBHOOK_TOKEN=your_mayar_webhook_token_here

# HMAC secret for Mayar webhook (enable after Mayar confirms signature format)
MAYAR_WEBHOOK_SECRET=your_mayar_webhook_secret_here

# Register this public callback URL in the Mayar dashboard:
# https://your-domain.vercel.app/api/payment/webhook

# Base URL API Mayar (Default: https://api.mayar.id/hl/v2)
MAYAR_BASE_URL=https://api.mayar.id/hl/v2

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy semua nilai di atas ke .env.local (development)
# 2. Ganti placeholder dengan nilai asli:
#    - SUPABASE_URL & KEYS: dari Supabase dashboard
#    - BANK_ACCOUNT_NUMBER: nomor rekening Mandiri Anda
#    - BANK_ACCOUNT_NAME: nama rekening
#    - FONNTE_TOKEN: dari https://fonnte.com/dashboard
#    - SUPPORT_PHONE_NUMBER: nomor WA support
#    - CRON_SECRET_TOKEN: generate pakai: openssl rand -hex 32
#    - NEXT_PUBLIC_APP_URL: domain Anda
# 3. Deploy ke Vercel & set env di Vercel dashboard
# 4. Test dengan: curl -H "Authorization: Bearer [TOKEN]" https://your-domain/api/cron/send-tagihan-reminder

# ========================================
# SECURITY NOTES
# ========================================
# - JANGAN share SUPABASE_SERVICE_ROLE_KEY
# - JANGAN share FONNTE_TOKEN
# - JANGAN share CRON_SECRET_TOKEN
# - Gunakan .env.local untuk development
# - Gunakan Vercel dashboard untuk production
# - Audit logs tersimpan di Supabase untuk track changes
