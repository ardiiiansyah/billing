# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cron Job Security
CRON_SECRET=generate_random_32_char_secret_here

# WhatsApp Bot (Fonnte)
FONNTE_TOKEN=your_fonnte_api_token_here

# Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Web Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Mayar Payment Gateway (https://mayar.id)
# MAYAR_ENV: "sandbox" (api.mayar.io) or "production" (api.mayar.id).
# Defaults to sandbox so an unconfigured deployment never charges real money.
MAYAR_ENV=sandbox
MAYAR_API_KEY=your_mayar_api_key_here
# Optional explicit override. Sandbox: https://api.mayar.io/hl/v2
# Production: https://api.mayar.id/hl/v2
MAYAR_BASE_URL=https://api.mayar.io/hl/v2
# Shared secret. Register the webhook URL as:
# https://your-domain.vercel.app/api/payment/webhook?token=<MAYAR_WEBHOOK_SECRET>
MAYAR_WEBHOOK_SECRET=your_mayar_webhook_secret_here
# Re-check every webhook against the Mayar API before marking an invoice paid.
MAYAR_VERIFY_WEBHOOK=true
# Send Mayar email receipts. Leave false for sandbox / WhatsApp-only billing.
MAYAR_SEND_EMAIL=false

# Bank Account Info (for manual payment reference)
BANK_ACCOUNT_NUMBER=your_bank_account_number
BANK_ACCOUNT_NAME=your_bank_account_name
DANA_ACCOUNT=your_dana_phone_number

# Error Monitoring (Sentry) - Optional but HIGHLY recommended for production
# Get your DSN from https://sentry.io after creating a project
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
